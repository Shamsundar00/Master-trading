# Market Academy ₹999 Expert Trading Workshop: environment settings
# 1. Copy this file to `.env.production` in the project root (it is git-ignored).
# 2. Fill every line marked [REQUIRED]. Lines marked [OPTIONAL] can stay empty.
# 3. Run `npm install` then `npm run build`, and upload the `dist/` folder.
# Note: every VITE_ value is compiled into the page's public JavaScript (same as the
# existing marketacademy.in event pages), so never put a server-only secret here.

# ---------- Page address ----------
# [REQUIRED] Final public URL of this page, ending with "/" (used for share previews)
VITE_SITE_URL=https://marketacademy.in/expert-trading-workshop/

# ---------- Event on the events backend ----------
# [REQUIRED] event_id of the ₹999 workshop event
VITE_EVENT_ID=
# [OPTIONAL] page slug the events API uses to find this event
VITE_EVENT_SLUG=expert-trading-workshop

# [REQUIRED] Ticket type per slot (event_ticket_type_id). Use EITHER the four slot IDs
# below, OR one shared ID in VITE_DEFAULT_TICKET_TYPE_ID (the chosen slot is sent too).
VITE_TICKET_TYPE_SAT_MORNING=
VITE_TICKET_TYPE_SAT_AFTERNOON=
VITE_TICKET_TYPE_SUN_MORNING=
VITE_TICKET_TYPE_SUN_AFTERNOON=
VITE_DEFAULT_TICKET_TYPE_ID=

# ---------- Booking + Cashfree (same webhooks as the Price Action Masterclass page) ----------
# Register = saves the lead and creates the Cashfree order (returns payment_session_id)
VITE_REGISTER_URL=https://automation-v2.enrichmoney.in/webhook/events/register
VITE_PAYMENT_STATUS_URL=https://automation-v2.enrichmoney.in/webhook/events/register/payment-status
# [REQUIRED] Bearer token the webhooks expect
VITE_API_TOKEN=
# [REQUIRED] 32-character AES-256 key for the encrypted {"data": "..."} payloads.
# Leave empty only if the backend accepts plain JSON.
VITE_PAYLOAD_AES_KEY=
# production | sandbox (use sandbox only with Cashfree test credentials on the backend)
VITE_CASHFREE_MODE=production
# [OPTIONAL] Leave empty to return to this page: <page>?payment_status=processing&order_id={order_id}
VITE_RETURN_URL=

# ---------- [OPTIONAL] Live seat counts per slot ----------
VITE_EVENTS_API_URL=https://automation-v2.enrichmoney.in/webhook/events
VITE_EVENTS_SECRET_SALT=

# ---------- [OPTIONAL] Extras ----------
# Extra copy of every lead (Google Sheet / CRM / Pabbly webhook URL), sent before payment
VITE_LEAD_WEBHOOK_URL=
# true = fake payment flow for QA (no API calls). Must be false on the live site.
VITE_DEMO_BOOKING=false
# true = don't load GTM / Meta Pixel / LinkedIn (e.g. on a staging copy)
VITE_DISABLE_TRACKING=false
