# Copy to `.env.production` (or set in your CI/host) before `npm run build`.
# Every VITE_* value is compiled into the public JS bundle — same as the
# existing marketacademy.in event pages. Don't put server-only secrets here.

# ── Page URL (canonical + Open Graph image) ────────────────────────────────
VITE_SITE_URL=https://marketacademy.in/expert-trading-workshop/
# Asset base path. Default './' works from any sub-folder or subdomain.
# VITE_BASE=/expert-trading-workshop/

# ── Event on the Enrich Money events backend ───────────────────────────────
VITE_EVENT_ID=
VITE_EVENT_SLUG=expert-trading-workshop
# Used for every slot unless a slot has its own ticketTypeId in src/config/event.js
VITE_DEFAULT_TICKET_TYPE_ID=

# ── Booking / payment endpoints (same webhooks the Price Action page uses) ─
# Register = lead capture + Cashfree order creation. Returns payment_session_id.
VITE_REGISTER_URL=https://automation-v2.enrichmoney.in/webhook/events/register
VITE_PAYMENT_STATUS_URL=https://automation-v2.enrichmoney.in/webhook/events/register/payment-status
# Optional: live prices / seat counts per slot
VITE_EVENTS_API_URL=https://automation-v2.enrichmoney.in/webhook/events
VITE_EVENTS_SECRET_SALT=

# Bearer token + AES-256 key (32 chars) the webhooks expect.
# Leave the AES key empty to send/receive plain JSON instead of {"data":"<hex>"}.
VITE_API_TOKEN=
VITE_PAYLOAD_AES_KEY=

# production | sandbox
VITE_CASHFREE_MODE=production
# Optional. Default: <this page>?payment_status=processing&order_id={order_id}
VITE_RETURN_URL=

# ── Optional extras ─────────────────────────────────────────────────────────
# Extra fire-and-forget lead copy (Google Sheet / CRM / Pabbly) sent before payment
VITE_LEAD_WEBHOOK_URL=
# true = simulate payment end-to-end (QA only). Same as adding ?demo=1 to the URL.
VITE_DEMO_BOOKING=false
# true = don't load GTM / Meta Pixel / LinkedIn (e.g. on a staging host)
VITE_DISABLE_TRACKING=false
